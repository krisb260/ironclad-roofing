# Ironclad Roofing Co. — environment template
# Copy to .env and fill in the real values at deploy time.
# NEVER commit a real .env — these keys move money and create leads.

# Company API key from whop.com/dashboard/developer (or the sandbox
# dashboard for testing). Used server-side only, stored as an app secret
# with `whop apps secrets set` at deploy time.
IRONCLAD_API_KEY=

# The Whop business (company) this site sells for, e.g. biz_xxxxxxxx.
WHOP_ACCOUNT_ID=

# Webhook signing secret for the /api/webhooks/whop endpoint, e.g. ws_xxxxxxxx.
IRONCLAD_WEBHOOK_SECRET=

# Same business id as WHOP_ACCOUNT_ID — the Legacy v2 Leads API takes
# `company_id`. Kept separate so the sandbox/production split is explicit.
WHOP_COMPANY_ID=

# Port the server listens on when run locally (default 3000).
PORT=3000
